<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="0;url=/et" />
    <script is:inline>
      try {
        var lang = navigator.language || navigator.userLanguage;
        var supported = ['et', 'en', 'ru'];
        var prefix = lang.split('-')[0].toLowerCase();
        
        if (supported.includes(prefix)) {
            window.location.href = '/' + prefix + '/';
        } else {
            window.location.href = '/et/';
        }
      } catch (e) {
        window.location.href = '/et/';
      }
    </script>
  </head>
  <body>
  </body>
</html>
