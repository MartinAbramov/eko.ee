---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header";
import Hero from "../../components/Hero";
import About from "../../components/About";
import BusinessLines from "../../components/BusinessLines";
import Contact from "../../components/Contact";
import Footer from "../../components/Footer";
import MobileStickyNav from "../../components/MobileStickyNav";
import { ui } from "../../i18n/ui";
import { Language } from "../../types";

export function getStaticPaths() {
  return [
    { params: { lang: "et" }, props: { lang: "et" } },
    { params: { lang: "en" }, props: { lang: "en" } },
    { params: { lang: "ru" }, props: { lang: "ru" } },
  ];
}

const { lang } = Astro.props;
const currentLang = lang;
const content = ui[currentLang];

const { title, description } = content.meta;
---

<Layout title={title} description={description} lang={Astro.params.lang}>
  <Header
    content={content.nav}
    currentLang={currentLang}
    client:load
  />

  <main>
    <Hero content={content.hero} />
    <About content={content.about} />
    <BusinessLines content={content.products} />
    <Contact content={content.contact} />
  </main>

  <Footer content={content.footer} />

  <MobileStickyNav content={content.contact} client:media="(max-width: 768px)" />
</Layout>
