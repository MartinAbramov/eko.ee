---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import BusinessLines from '../../components/BusinessLines.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import MobileStickyNav from '../../components/MobileStickyNav.astro';
import { ui } from '../../i18n/ui';
import { Language } from '../../types';

export function getStaticPaths() {
  return [
    { params: { lang: 'et' }, props: { lang: 'et' } },
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'ru' }, props: { lang: 'ru' } },
  ];
}

const { lang } = Astro.props;
const currentLang = lang as Language;
const content = ui[currentLang];

const { title, description } = content.meta;
---

<Layout title={title} description={description} lang={Astro.params.lang}>
  <Header content={content.nav} currentLang={currentLang} />

  <main>
    <Hero
      content={content.hero}
      partnerHref={`/${currentLang}/partner`}
    />
    <About
      content={content.about}
      partnerHref={`/${currentLang}/partner`}
    />
    <BusinessLines content={content.products} />
    <Contact
      content={content.contact}
      partnerHref={`/${currentLang}/partner`}
    />
  </main>

  <Footer content={content.footer} currentLang={currentLang} />

  <MobileStickyNav content={content.contact} />
</Layout>
