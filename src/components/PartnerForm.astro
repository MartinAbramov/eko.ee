---
import { Content } from '../types';
import { FORMSPREE_URL } from '../constants';
import { ChevronDown } from 'lucide-astro';

interface Props {
  content: Content['partner'];
  lang: string;
}

const { content, lang } = Astro.props;

const fieldClass =
  'w-full px-4 py-3 rounded-md bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-baltic-blue dark:focus:ring-goodyear-gold transition-all';
const labelClass = 'text-sm font-bold text-gray-500 dark:text-gray-400';
---

<div
  class="bg-white dark:bg-slate-900 p-6 md:p-8 rounded-lg shadow-md border-t-4 border-goodyear-gold"
>
  <h2
    class="text-2xl font-display font-bold text-baltic-blue dark:text-white mb-6"
  >
    {content.formTitle}
  </h2>

  <form action={FORMSPREE_URL} method="POST" class="space-y-4">
    <input type="hidden" name="form_type" value="partner" />
    <input type="hidden" name="language" value={lang} />
    <input
      type="hidden"
      name="_subject"
      value="EKOIMPEX partner application"
    />

    <div class="grid md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="first_name" class={labelClass}>
          {content.firstNameLabel}
        </label>
        <input
          type="text"
          name="first_name"
          id="first_name"
          autocomplete="given-name"
          required
          class={fieldClass}
        />
      </div>
      <div class="space-y-1">
        <label for="last_name" class={labelClass}>
          {content.lastNameLabel}
        </label>
        <input
          type="text"
          name="last_name"
          id="last_name"
          autocomplete="family-name"
          required
          class={fieldClass}
        />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="partner_email" class={labelClass}>
          {content.emailLabel}
        </label>
        <input
          type="email"
          name="email"
          id="partner_email"
          autocomplete="email"
          required
          class={fieldClass}
        />
      </div>
      <div class="space-y-1">
        <label for="partner_phone" class={labelClass}>
          {content.phoneLabel}
        </label>
        <input
          type="tel"
          name="phone"
          id="partner_phone"
          autocomplete="tel"
          required
          class={fieldClass}
        />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="company" class={labelClass}>
          {content.companyLabel}
        </label>
        <input
          type="text"
          name="company"
          id="company"
          autocomplete="organization"
          required
          class={fieldClass}
        />
      </div>
      <div class="space-y-1">
        <label for="reg_code" class={labelClass}>
          {content.regCodeLabel}
        </label>
        <input
          type="text"
          name="reg_code"
          id="reg_code"
          inputmode="numeric"
          required
          class={fieldClass}
        />
      </div>
    </div>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="vat" class={labelClass}>{content.vatLabel}</label>
        <input type="text" name="vat" id="vat" class={fieldClass} />
      </div>
      <div class="space-y-1">
        <label for="city" class={labelClass}>{content.cityLabel}</label>
        <input
          type="text"
          name="city"
          id="city"
          autocomplete="address-level2"
          class={fieldClass}
        />
      </div>
    </div>

    <div class="space-y-1">
      <label for="website" class={labelClass}>{content.websiteLabel}</label>
      <input
        type="text"
        name="website"
        id="website"
        autocomplete="url"
        class={fieldClass}
      />
    </div>

    <div class="space-y-1">
      <label for="partner_interest" class={labelClass}>
        {content.interestLabel}
      </label>
      <div class="relative">
        <select
          name="interest"
          id="partner_interest"
          class={`${fieldClass} appearance-none cursor-pointer pr-10`}
        >
          <option value="Both">{content.optionBoth}</option>
          <option value="Lubricants">{content.optionLubricants}</option>
          <option value="Additives">{content.optionAdditives}</option>
        </select>
        <ChevronDown
          size={20}
          class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-300"
        />
      </div>
    </div>

    <div class="space-y-1">
      <label for="partner_message" class={labelClass}>
        {content.messageLabel}
      </label>
      <textarea
        name="message"
        id="partner_message"
        rows="4"
        required
        placeholder={content.messagePlaceholder}
        class={`${fieldClass} resize-none`}></textarea>
    </div>

    <p class="text-sm text-slate-500 dark:text-slate-400">
      {content.privacyNote}
    </p>

    <button
      type="submit"
      class="w-full md:w-auto px-8 py-3 bg-baltic-blue hover:bg-baltic-blue/90 dark:bg-goodyear-gold dark:hover:bg-goodyear-gold/90 text-white dark:text-baltic-blue font-bold rounded-md transition-colors shadow-lg"
    >
      {content.sendButton}
    </button>
  </form>
</div>
