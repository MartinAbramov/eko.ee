---
import { ArrowRight } from 'lucide-react';
import { Content } from '../types';

interface Props {
  content: Content['hero'];
}

const { content } = Astro.props;
---

<section
  id="hero"
  class="relative h-screen min-h-[600px] w-full overflow-hidden flex items-center"
>
  {/* Background Video with Overlay */}
  <div class="absolute inset-0 z-0">
    <video
      autoplay
      muted
      loop
      playsinline
      class="w-full h-full object-cover"
      poster="/Hero.webp"
    >
      <source src="/Hero.mp4" type="video/mp4" />
      {/* Fallback for browsers that don't support video */}
      <img
        src="/Hero.webp"
        alt="Background"
        width="1913"
        height="999"
        class="w-full h-full object-cover"
      />
    </video>

    {/* Deep Blue Gradient Overlay */}
    <div class="absolute inset-0 bg-hero-gradient"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10 pt-20">
    <div class="max-w-3xl">
      <div class="inline-block px-3 py-1 bg-goodyear-gold text-baltic-blue text-xs font-bold uppercase tracking-wider mb-6 rounded-sm">
        EKOIMPEX
      </div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight mb-6">
        {content.title}
      </h1>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#products"
          class="bg-goodyear-gold text-baltic-blue hover:bg-yellow-400 px-8 py-4 rounded font-bold text-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2"
        >
          {content.cta}
          <ArrowRight size={20} />
        </a>
      </div>
    </div>
  </div>

  {/* Decorative Strip */}
  <div class="absolute bottom-0 left-0 w-full h-2 bg-gradient-to-r from-goodyear-gold via-eco-green to-baltic-blue"></div>
</section>
