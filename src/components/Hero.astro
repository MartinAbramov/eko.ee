---
import { ArrowRight } from 'lucide-astro';
import heroImage from '../assets/Hero.webp';
import { Content } from '../types';

interface Props {
  content: Content['hero'];
}

const { content } = Astro.props;
---

<section
  id="hero"
  class="relative h-screen min-h-[600px] w-full overflow-hidden flex items-center"
>
  {/* Background Video with Overlay */}
  <div class="absolute inset-0 z-0">
    <video
      id="hero-video"
      autoplay
      muted
      loop
      playsinline
      class="w-full h-full object-cover"
      poster={heroImage.src}
    >
    </video>

    {/* Deep Blue Gradient Overlay */}
    <div class="absolute inset-0 bg-hero-gradient"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10 pt-20">
    <div class="max-w-3xl">
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-display font-bold text-white leading-tight mb-6"
      >
        {content.title}
      </h1>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="#products"
          class="bg-goodyear-gold text-baltic-blue hover:bg-yellow-400 px-8 py-4 rounded font-bold text-lg transition-all transform hover:scale-105 flex items-center justify-center gap-2"
        >
          {content.cta}
          <ArrowRight size={20} />
        </a>
      </div>
    </div>
  </div>

  {/* Decorative Strip */}
  <div
    class="absolute bottom-0 left-0 w-full h-2 bg-gradient-to-r from-goodyear-gold via-eco-green to-baltic-blue"
  >
  </div>
</section>

<script>
  const video = document.getElementById('hero-video') as HTMLVideoElement;
  if (video) {
    const now = new Date();
    const month = now.getMonth();
    const date = now.getDate();
    // "Not winter" is defined as April 1st to December 1st inclusive
    // const isNotWinter = month >= 3 && month < 11;

    const source = document.createElement('source');
    // if (isNotWinter) {
    //   source.src = '/Summer.mp4';
    //   source.type = 'video/mp4';
    // } else {
    source.src = '/Hero.webm';
    source.type = 'video/webm';
    // }

    video.appendChild(source);
    video.load();
  }
</script>
