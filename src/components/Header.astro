---
import { Menu, X, Phone, ArrowRight } from 'lucide-astro';
import { Language, Content } from '../types';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { PHONE_PRIMARY } from '../constants';

interface Props {
  content: Content['nav'];
  currentLang: Language;
  solid?: boolean;
}

const { content, currentLang, solid = false } = Astro.props;
const homeHref = `/${currentLang}/`;
const partnerHref = `/${currentLang}/partner`;
---

<header
  id="main-header"
  data-solid={solid ? 'true' : 'false'}
  class:list={[
    'group fixed top-0 left-0 w-full z-50 transition-all duration-300',
    solid
      ? 'bg-white dark:bg-slate-900 shadow-md py-2'
      : 'bg-transparent py-4',
  ]}
>
  <div class="container mx-auto px-4 md:px-6 flex justify-between items-center gap-4">
    {/* Logo */}
    <a
      id="logo-link"
      href={homeHref}
      class="cursor-pointer block bg-white shrink-0"
      data-home-href={homeHref}
    >
      <Logo class="h-10 md:h-16 w-auto" />
    </a>

    {/* Desktop Nav */}
    <nav class="hidden lg:flex items-center gap-8">
      <a href={`${homeHref}#about`} class="site-nav-link">
        {content.about}
      </a>
      <a href={`${homeHref}#products`} class="site-nav-link">
        {content.products}
      </a>
      <a href={`${homeHref}#contact`} class="site-nav-link">
        {content.contact}
      </a>
    </nav>

    <div class="hidden lg:flex items-center gap-5">
      <div id="lang-switcher-desktop">
        <LanguageSwitcher currentLang={currentLang} variant="light" />
      </div>

      <ThemeToggle />

      <a
        href={partnerHref}
        class="border-2 border-goodyear-gold bg-goodyear-gold/10 text-goodyear-gold group-[.bg-white]:bg-goodyear-gold group-[.bg-white]:text-baltic-blue dark:group-[.bg-white]:bg-goodyear-gold dark:group-[.bg-white]:text-baltic-blue px-4 py-2 rounded font-bold hover:bg-goodyear-gold hover:text-baltic-blue transition-colors whitespace-nowrap inline-flex items-center gap-2"
      >
        {content.partner}
        <ArrowRight size={16} />
      </a>

      <a
        href={`tel:${PHONE_PRIMARY.replace(/\s/g, '')}`}
        class="flex items-center gap-2 bg-goodyear-gold text-baltic-blue px-4 py-2 rounded font-bold hover:bg-yellow-400 transition-colors whitespace-nowrap"
      >
        <Phone size={16} class="shrink-0" />
        <span class="hidden xl:inline">{PHONE_PRIMARY}</span>
      </a>
    </div>

    {/* Mobile Menu Toggle */}
    <div class="lg:hidden flex items-center gap-4">
      <div id="lang-switcher-mobile-header" class="hidden">
        <LanguageSwitcher currentLang={currentLang} />
      </div>
      <button
        id="mobile-menu-btn"
        class={solid ? 'text-baltic-blue dark:text-white' : 'text-white'}
        aria-label="Toggle menu"
      >
        <div id="icon-menu">
          <Menu size={28} />
        </div>
        <div id="icon-close" class="hidden">
          <X size={28} />
        </div>
      </button>
    </div>
  </div>

  {/* Mobile Menu Overlay */}
  <div
    id="mobile-menu-overlay"
    class="absolute top-full left-0 w-full bg-white dark:bg-slate-900 shadow-xl border-t border-gray-100 dark:border-gray-800 lg:hidden flex-col p-6 space-y-4 animate-fade-in-down hidden"
  >
    <a
      href={`${homeHref}#about`}
      class="block text-lg font-medium text-baltic-blue dark:text-gray-200 text-left py-2 border-b border-gray-100 dark:border-gray-800 w-full"
    >
      {content.about}
    </a>
    <a
      href={`${homeHref}#products`}
      class="block text-lg font-medium text-baltic-blue dark:text-gray-200 text-left py-2 border-b border-gray-100 dark:border-gray-800 w-full"
    >
      {content.products}
    </a>
    <a
      href={`${homeHref}#contact`}
      class="block text-lg font-medium text-baltic-blue dark:text-gray-200 text-left py-2 border-b border-gray-100 dark:border-gray-800 w-full"
    >
      {content.contact}
    </a>
    <a
      href={partnerHref}
      class="flex items-center justify-center gap-2 text-center text-lg font-bold text-baltic-blue dark:text-baltic-blue bg-goodyear-gold hover:bg-yellow-400 py-3 rounded w-full"
    >
      {content.partner}
      <ArrowRight size={20} />
    </a>
    <div class="pt-2 flex justify-between items-center">
      <span class="text-sm text-gray-500 dark:text-gray-400">Language:</span>
      <LanguageSwitcher currentLang={currentLang} variant="light" />
    </div>
    <div
      class="pt-4 border-t border-gray-100 dark:border-gray-800 flex justify-end"
    >
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  // SCROLL LOGIC
  const header = document.getElementById('main-header');
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const desktopLangSwitcher = document.querySelector('#lang-switcher-desktop'); // Simple selector assumption, might need refining or props passing
  const mobileHeaderLangSwitcher = document.getElementById(
    'lang-switcher-mobile-header',
  );

  // We need to manipulate LanguageSwitcher variant styles dynamically or swap components.
  // Since Astro components are static HTML, we rendered one variant.
  // Actually, we can just toggle classes on the header and let CSS descendants handle it,
  // OR we can't easily change the React-like "variant" prop at runtime without re-rendering.
  // Solution: The LanguageSwitcher styles are simple classes. We can toggle `header` classes
  // and use CSS inheritance, or simply stick to one readable variant if possible,
  // OR toggle visibility of two rendered switchers (heavy),
  // OR just assume "light" means white text and "dark" means dark text, and toggle classes on scroll.

  // Let's go with toggling classes on the header element for state: .scrolled
  const isSolidHeader = header?.dataset.solid === 'true';

  function updateHeaderState() {
    const isScrolled = isSolidHeader || window.scrollY > 20;

    if (isScrolled) {
      header?.classList.add(
        'bg-white',
        'dark:bg-slate-900',
        'shadow-md',
        'py-2',
      );
      header?.classList.remove('bg-transparent', 'py-4');

      // Toggle Mobile Button Color
      mobileBtn?.classList.remove('text-white');
      mobileBtn?.classList.add('text-baltic-blue', 'dark:text-white');

      // Show mobile header lang switcher if needed
      mobileHeaderLangSwitcher?.classList.remove('hidden');
      mobileHeaderLangSwitcher?.classList.add('block');

      desktopLangSwitcher?.classList.remove('text-white');
      desktopLangSwitcher?.classList.add('text-baltic-blue');
    } else {
      header?.classList.remove(
        'bg-white',
        'dark:bg-slate-900',
        'shadow-md',
        'py-2',
      );
      header?.classList.add('bg-transparent', 'py-4');

      mobileBtn?.classList.add('text-white');
      mobileBtn?.classList.remove('text-baltic-blue', 'dark:text-white');

      desktopLangSwitcher?.classList.remove('text-baltic-blue');
      desktopLangSwitcher?.classList.add('text-white');

      mobileHeaderLangSwitcher?.classList.add('hidden');
      mobileHeaderLangSwitcher?.classList.remove('block');
    }
  }

  // MOBILE MENU LOGIC
  const menuOverlay = document.getElementById('mobile-menu-overlay');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');
  let isMenuOpen = false;

  mobileBtn?.addEventListener('click', () => {
    isMenuOpen = !isMenuOpen;
    if (isMenuOpen) {
      menuOverlay?.classList.remove('hidden');
      menuOverlay?.classList.add('flex');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
      // Force header to white background when menu is open
      header?.classList.add('bg-white', 'dark:bg-slate-900');
      header?.classList.remove('bg-transparent');
      mobileBtn?.classList.remove('text-white');
      mobileBtn?.classList.add('text-baltic-blue', 'dark:text-white');
    } else {
      menuOverlay?.classList.add('hidden');
      menuOverlay?.classList.remove('flex');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
      // Revert header state if at top
      if (window.scrollY <= 20) {
        header?.classList.remove('bg-white', 'dark:bg-slate-900');
        header?.classList.add('bg-transparent');
        mobileBtn?.classList.add('text-white');
        mobileBtn?.classList.remove('text-baltic-blue', 'dark:text-white');
      }
    }
  });

  // Scroll Listeners
  window.addEventListener('scroll', updateHeaderState);

  document.querySelectorAll('#mobile-menu-overlay a').forEach((link) => {
    link.addEventListener('click', () => {
      isMenuOpen = false;
      menuOverlay?.classList.add('hidden');
      menuOverlay?.classList.remove('flex');
      iconMenu?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    });
  });

  const logoLink = document.getElementById('logo-link') as HTMLAnchorElement | null;
  logoLink?.addEventListener('click', (e) => {
    const home = logoLink.dataset.homeHref;
    const path = window.location.pathname.replace(/\/$/, '') + '/';
    if (home && path === home) {
      e.preventDefault();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  });

  // Initial Check
  updateHeaderState();
</script>

<style>
  /* CSS Variable approach for Language Switcher colors to avoid complex JS DOM manipulation */
  /* Define default (transparent header) colors */
  :global(#lang-switcher-desktop a:hover) {
    opacity: 1;
    font-weight: bold;
  }
  :global(#lang-switcher-desktop a.font-bold) {
    color: #ffd100; /* Active: Goodyear Gold */
    opacity: 1;
  }
  :global(#lang-switcher-desktop span) {
    color: white;
    opacity: 0.5;
  }

  /* When header has white bg */
  :global(#main-header.bg-white #lang-switcher-desktop a:hover) {
    color: #004ea8 !important; /* baltic-blue */
  }
  :global(#main-header.dark\:bg-slate-900 #lang-switcher-desktop a:hover) {
    color: #ffd100 !important; /* gold hover */
  }
  :global(#main-header.bg-white #lang-switcher-desktop a.font-bold) {
    color: #004ea8 !important; /* Active: baltic-blue */
    opacity: 1;
  }
  :global(#main-header.dark\:bg-slate-900 #lang-switcher-desktop a.font-bold) {
    color: #ffd100 !important; /* Active: gold */
    opacity: 1;
  }
  :global(#main-header.bg-white #lang-switcher-desktop span) {
    color: #64748b; /* slate-500 - clearly visible separator */
  }
  :global(#main-header.dark\:bg-slate-900 #lang-switcher-desktop span) {
    color: #475569; /* slate-600 */
  }

  :global(#main-header .site-nav-link) {
    font-weight: 600;
    white-space: nowrap;
    color: white;
    transition: color 0.2s ease;
  }
  :global(#main-header .site-nav-link:hover) {
    color: #ffd100;
  }
  :global(#main-header.bg-white .site-nav-link) {
    color: #002b49;
  }
  :global(#main-header.bg-white .site-nav-link:hover) {
    color: #d4af00;
  }
  :global(html.dark #main-header.bg-white .site-nav-link),
  :global(html.dark #main-header.dark\:bg-slate-900 .site-nav-link) {
    color: #f1f5f9;
  }
  :global(html.dark #main-header .site-nav-link:hover) {
    color: #ffd100;
  }
</style>
