---
import { Content } from '../types';
import { BUSINESS_PARTNERS } from '../constants';
import { MapPin } from 'lucide-astro';

interface Props {
  content: Content['partners'];
}

const { content } = Astro.props;
---

<section id="partners" class="py-20 bg-industrial-grey dark:bg-slate-950">
  <div class="container mx-auto px-4 mb-16 text-center">
    <h2
      class="text-3xl md:text-4xl font-display font-bold text-baltic-blue dark:text-white mb-4"
    >
      {content.title}
    </h2>
    <div class="h-1 w-24 bg-goodyear-gold mx-auto"></div>
  </div>

  <div class="container mx-auto px-4 max-w-7xl">
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        BUSINESS_PARTNERS.map((partner) => (
          <div class="bg-white dark:bg-slate-900 p-6 rounded-lg shadow-sm border-t-4 border-goodyear-gold">
            <h3 class="text-lg font-display font-bold text-baltic-blue dark:text-white mb-3">
              {partner.name}
            </h3>
            <p class="flex items-start gap-2 text-slate-600 dark:text-slate-300">
              <MapPin
                size={18}
                class="text-goodyear-gold shrink-0 mt-0.5"
              />
              <span>{partner.address}</span>
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
