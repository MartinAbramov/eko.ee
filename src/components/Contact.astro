---
import { Content } from '../types';
import { MapPin, Phone, Mail, Navigation, Instagram, ChevronDown, ArrowRight } from 'lucide-astro';
import {
  PHONE_PRIMARY,
  PHONE_SECONDARY,
  EMAIL_CONTACT as EMAIL_MAIN,
  ADDRESS_MAP_URL,
  WAZE_LINK,
  FORMSPREE_URL,
  INSTAGRAM_URL,
} from '../constants';

interface Props {
  content: Content['contact'];
  partnerHref: string;
}

const { content, partnerHref } = Astro.props;
---

<section id="contact" class="py-20 bg-industrial-grey dark:bg-slate-950">
  <div class="container mx-auto px-4">
    <div class="text-center mb-16">
      <h2
        class="text-3xl md:text-4xl font-display font-bold text-baltic-blue dark:text-white mb-4"
      >
        {content.title}
      </h2>
      <div class="h-1 w-24 bg-eco-green mx-auto"></div>
    </div>

        <div class="grid lg:grid-cols-5 gap-8 max-w-7xl mx-auto">
          {/* Left Side: Contact Info & Form */}
          <div class="lg:col-span-2 space-y-6">
            <div class="space-y-6">
              {/* Address Card */}
              <div
                class="bg-white dark:bg-slate-900 p-6 rounded-lg shadow-sm border-t-4 border-baltic-blue hover:shadow-md transition-shadow"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="p-3 bg-blue-100 dark:bg-slate-800 rounded-full text-baltic-blue dark:text-goodyear-gold"
                  >
                    <MapPin size={24} />
                  </div>
                  <div>
                    <h4
                      class="text-sm uppercase font-bold text-gray-500 dark:text-gray-400 mb-1"
                    >
                      {content.addressLabel}
                    </h4>
                    <p
                      class="font-medium text-slate-800 dark:text-white text-lg leading-snug mb-4"
                    >
                      {content.address}
                    </p>
                    <a
                      href={WAZE_LINK}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-2 text-sm font-bold text-baltic-blue dark:text-goodyear-gold hover:text-eco-green transition-colors"
                    >
                      <Navigation size={16} />
                      {content.directions}
                    </a>
                  </div>
                </div>
              </div>
    
              {/* Phones Card */}
              <div
                class="bg-white dark:bg-slate-900 p-6 rounded-lg shadow-sm border-t-4 border-goodyear-gold hover:shadow-md transition-shadow"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="p-3 bg-yellow-100 dark:bg-slate-800 rounded-full text-baltic-blue dark:text-goodyear-gold"
                  >
                    <Phone size={24} />
                  </div>
                  <div>
                    <h4
                      class="text-sm uppercase font-bold text-gray-500 dark:text-gray-400 mb-1"
                    >
                      {content.phoneLabel}
                    </h4>
                    <div class="flex flex-col gap-2">
                      <a
                        href={`tel:${PHONE_PRIMARY.replace(/\s/g, '')}`}
                        class="font-bold text-xl text-slate-800 dark:text-white hover:text-goodyear-gold transition-colors"
                      >
                        {PHONE_PRIMARY}
                      </a>
                      <a
                        href={`tel:${PHONE_SECONDARY.replace(/\s/g, '')}`}
                        class="font-bold text-xl text-slate-800 dark:text-white hover:text-goodyear-gold transition-colors"
                      >
                        {PHONE_SECONDARY}
                      </a>
                    </div>
                  </div>
                </div>
              </div>
    
              {/* Email Card */}
              <div
                class="bg-white dark:bg-slate-900 p-6 rounded-lg shadow-sm border-t-4 border-eco-green hover:shadow-md transition-shadow"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="p-3 bg-green-100 dark:bg-slate-800 rounded-full text-eco-green"
                  >
                    <Mail size={24} />
                  </div>
                  <div>
                    <h4
                      class="text-sm uppercase font-bold text-gray-500 dark:text-gray-400 mb-1"
                    >
                      {content.emailLabel}
                    </h4>
                    <a
                      href={`mailto:${EMAIL_MAIN}`}
                      class="font-medium text-lg text-slate-800 dark:text-white hover:text-eco-green transition-colors break-all"
                    >
                      {EMAIL_MAIN}
                    </a>
                  </div>
                </div>
              </div>

              {/* Instagram Card */}
              <div
                class="bg-white dark:bg-slate-900 p-6 rounded-lg shadow-sm border-t-4 border-goodyear-gold hover:shadow-md transition-shadow"
              >
                <div class="flex items-start gap-4">
                  <div
                    class="p-3 bg-yellow-100 dark:bg-slate-800 rounded-full text-baltic-blue dark:text-goodyear-gold"
                  >
                    <Instagram size={24} />
                  </div>
                  <div>
                    <h4
                      class="text-sm uppercase font-bold text-gray-500 dark:text-gray-400 mb-1"
                    >
                      {content.instagramLabel}
                    </h4>
                    <a
                      href={INSTAGRAM_URL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-lg text-slate-800 dark:text-white hover:text-goodyear-gold transition-colors"
                    >
                      @goodyearlubricants
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
    
          {/* Right Side: Form */}
          <div class="lg:col-span-3">
            {/* Contact Form */}
            <div
              class="bg-white dark:bg-slate-900 p-8 rounded-lg shadow-md border-t-4 border-baltic-blue h-full"
            >
              <a
                href={partnerHref}
                class="mb-6 flex items-center justify-center gap-2 p-4 rounded-md bg-industrial-grey dark:bg-slate-800 border border-goodyear-gold hover:bg-goodyear-gold/10 transition-colors font-bold text-baltic-blue dark:text-goodyear-gold"
              >
                {content.partnerCta}
                <ArrowRight size={18} />
              </a>
              <form
                action={FORMSPREE_URL}
                method="POST"
                class="space-y-4"
              >
                <div class="grid md:grid-cols-2 gap-4">
                  <div class="space-y-1">
                    <label
                      for="name"
                      class="text-sm font-bold text-gray-500 dark:text-gray-400"
                    >
                      {content.nameLabel}
                    </label>
                    <input
                      type="text"
                      name="name"
                      id="name"
                      required
                      class="w-full px-4 py-3 rounded-md bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-baltic-blue dark:focus:ring-goodyear-gold transition-all"
                    />
                  </div>
                  <div class="space-y-1">
                    <label
                      for="email"
                      class="text-sm font-bold text-gray-500 dark:text-gray-400"
                    >
                      {content.emailLabel}
                    </label>
                    <input
                      type="email"
                      name="email"
                      id="email"
                      required
                      class="w-full px-4 py-3 rounded-md bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-baltic-blue dark:focus:ring-goodyear-gold transition-all"
                    />
                  </div>
                </div>
                <div class="space-y-1">
                  <label
                    for="interest"
                    class="text-sm font-bold text-gray-500 dark:text-gray-400"
                  >
                    {content.interestLabel}
                  </label>
                  <div class="relative">
                    <select
                      name="interest"
                      id="interest"
                      class="w-full px-4 py-3 pr-10 rounded-md bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-baltic-blue dark:focus:ring-goodyear-gold transition-all appearance-none cursor-pointer"
                    >
                      <option value="Lubricants">{content.optionLubricants}</option>
                      <option value="Additives">{content.optionAdditives}</option>
                      <option value="Other">{content.optionOther}</option>
                    </select>
                    <ChevronDown
                      size={20}
                      class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-slate-500 dark:text-slate-300"
                    />
                  </div>
                </div>
                <div class="space-y-1">
                  <label
                    for="message"
                    class="text-sm font-bold text-gray-500 dark:text-gray-400"
                  >
                    {content.messageLabel}
                  </label>
                  <textarea
                    name="message"
                    id="message"
                    rows="4"
                    required
                    class="w-full px-4 py-3 rounded-md bg-gray-50 dark:bg-slate-800 border border-gray-200 dark:border-slate-700 text-slate-800 dark:text-white focus:outline-none focus:ring-2 focus:ring-baltic-blue dark:focus:ring-goodyear-gold transition-all resize-none"
                  ></textarea>
                </div>
                <button
                  type="submit"
                  class="w-full md:w-auto px-8 py-3 bg-baltic-blue hover:bg-baltic-blue/90 dark:bg-goodyear-gold dark:hover:bg-goodyear-gold/90 text-white dark:text-baltic-blue font-bold rounded-md transition-colors shadow-lg"
                >
                  {content.sendButton}
                </button>
              </form>
            </div>
          </div>

          {/* Bottom: Map */}
          <div
            id="map-container"
            class="lg:col-span-5 min-h-[400px] rounded-xl overflow-hidden shadow-lg border border-gray-200 dark:border-slate-800 relative bg-gray-100 dark:bg-slate-800 group"
          >
            {/* Placeholder / Facade */}
            <div
              id="map-placeholder"
              class="absolute inset-0 flex items-center justify-center cursor-pointer"
            >
              <div class="text-center">
                <div
                  class="w-16 h-16 bg-white dark:bg-slate-700 rounded-full flex items-center justify-center shadow-md mx-auto mb-3 text-baltic-blue dark:text-goodyear-gold group-hover:scale-110 transition-transform duration-300"
                >
                  <MapPin size={32} />
                </div>
                <p class="text-sm font-bold text-gray-500 dark:text-gray-400">
                  Loading Map...
                </p>
              </div>
            </div>

            {/* Template for the Iframe (not rendered initially) */}
            <template id="map-template">
              <iframe
                src={ADDRESS_MAP_URL}
                width="100%"
                height="100%"
                style="border: 0; min-height: 400px;"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="EKOIMPEX Location"></iframe>
            </template>
          </div>
        </div>
        </div>  </div>
</section>

<script>
  // Lazy Load Map Logic
  document.addEventListener('DOMContentLoaded', () => {
    const mapContainer = document.getElementById('map-container');
    const mapPlaceholder = document.getElementById('map-placeholder');
    const mapTemplate = document.getElementById(
      'map-template',
    ) as HTMLTemplateElement;

    if (mapContainer && mapTemplate) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // User scrolled near the map
              const iframe = mapTemplate.content.cloneNode(true);
              mapContainer.appendChild(iframe);

              // Fade out placeholder
              if (mapPlaceholder) {
                mapPlaceholder.style.opacity = '0';
                setTimeout(() => {
                  mapPlaceholder.remove();
                }, 300); // match transition if we added one, currently instant removal after append is fine too
              }

              // Stop observing
              observer.disconnect();
            }
          });
        },
        { rootMargin: '200px' },
      ); // Load 200px before it comes into view

      observer.observe(mapContainer);
    }
  });
</script>
