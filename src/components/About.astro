---
import { Content } from '../types';
import { Award, Truck, CalendarClock } from 'lucide-react';

interface Props {
  content: Content['about'];
}

const { content } = Astro.props;
---

<section id="about" class="py-20 bg-industrial-grey dark:bg-slate-950">
  <div class="container mx-auto px-4 max-w-5xl">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="w-full md:w-1/2">
        <div class="relative">
          <div
            class="absolute -top-4 -left-4 w-20 h-20 border-t-4 border-l-4 border-goodyear-gold rounded-tl-3xl"
          >
          </div>
          <img
            src="/engine.webp"
            alt="Industrial Engine"
            loading="lazy"
            width="1024"
            height="559"
            class="rounded-lg shadow-lg w-full object-cover aspect-[4/3]"
          />
          <div
            class="absolute -bottom-4 -right-4 w-20 h-20 border-b-4 border-r-4 border-baltic-blue rounded-br-3xl"
          >
          </div>
        </div>
      </div>

      <div class="w-full md:w-1/2">
        <h2
          class="text-3xl font-display font-bold text-baltic-blue dark:text-white mb-6"
        >
          {content.title}
        </h2>
        <p
          class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-8"
        >
          {content.description}
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div
            class="flex items-center gap-3 p-4 bg-white dark:bg-slate-900 rounded shadow-sm border-l-4 border-goodyear-gold"
          >
            <Award class="text-baltic-blue dark:text-goodyear-gold shrink-0" />
            <span
              class="font-semibold text-sm text-slate-800 dark:text-slate-200"
            >
              {content.stat1}
            </span>
          </div>
          <div
            class="flex items-center gap-3 p-4 bg-white dark:bg-slate-900 rounded shadow-sm border-l-4 border-baltic-blue"
          >
            <Truck class="text-baltic-blue dark:text-goodyear-gold shrink-0" />
            <span
              class="font-semibold text-sm text-slate-800 dark:text-slate-200"
            >
              {content.stat2}
            </span>
          </div>
          <div
            class="flex items-center gap-3 p-4 bg-white dark:bg-slate-900 rounded shadow-sm border-l-4 border-eco-green"
          >
            <CalendarClock
              class="text-baltic-blue dark:text-goodyear-gold shrink-0"
            />
            <span
              class="font-semibold text-sm text-slate-800 dark:text-slate-200"
            >
              {content.stat3}
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
