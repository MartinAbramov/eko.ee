---
import { Content } from '../types';
import { Image } from 'astro:assets';
import goodyearProducts from '../assets/goodyear-products.png';
import { ArrowRight } from 'lucide-astro';

interface Props {
  content: Content['about'];
  partnerHref: string;
}

const { content, partnerHref } = Astro.props;
---

<section id="about" class="py-20 bg-industrial-grey dark:bg-slate-950">
  <div class="container mx-auto px-4 max-w-7xl">
    <div class="flex flex-col md:flex-row items-center gap-12">
      <div class="w-full md:w-1/2">
        <div class="relative">
          <div
            class="absolute -top-4 -left-4 w-20 h-20 border-t-4 border-l-4 border-goodyear-gold rounded-tl-3xl"
          >
          </div>
          <Image
            src={goodyearProducts}
            alt="Goodyear Lubricants"
            width={1600}
            height={900}
            class="rounded-lg shadow-lg w-full h-auto"
          />
          <div
            class="absolute -bottom-4 -right-4 w-20 h-20 border-b-4 border-r-4 border-baltic-blue rounded-br-3xl"
          >
          </div>
        </div>
      </div>

      <div class="w-full md:w-1/2">
        <div class="h-1 w-16 bg-goodyear-gold mb-6"></div>
        <h2
          class="text-3xl font-display font-bold text-baltic-blue dark:text-white mb-6"
        >
          {content.title}
        </h2>
        <p
          class="text-lg text-slate-800 dark:text-slate-200 font-medium leading-relaxed mb-4"
        >
          {content.description}
        </p>
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed mb-8">
          {content.details}
        </p>
        <a
          href={partnerHref}
          class="inline-flex items-center justify-center gap-2 bg-goodyear-gold text-baltic-blue hover:bg-yellow-400 px-8 py-4 rounded font-bold text-lg transition-colors"
        >
          {content.partnerCta}
          <ArrowRight size={20} class="shrink-0" />
        </a>
      </div>
    </div>
  </div>
</section>
